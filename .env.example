# Variables que hay que configurar en Render → Environment (NUNCA en el código)
# Copia los nombres; los valores reales solo van en Render.

# Firebase Admin (cuenta de servicio en base64) — ya existía
FIREBASE_SERVICE_ACCOUNT_B64=

# Clave para las rutas de administración (cabecera x-admin-key).
# Genera una larga y aleatoria, por ejemplo: openssl rand -hex 32
ADMIN_API_KEY=

# Telegram (token NUEVO tras revocar el anterior con @BotFather → /revoke)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The Odds API: claves NUEVAS separadas por comas (3, 4 o más)
ODDS_API_KEYS=

# Agentes de IA (claves NUEVAS)
GEMINI_API_KEY=
GROQ_API_KEY=

# Cloudflare Workers AI — ya existían
CF_ACCOUNT_ID=
CF_TOKEN=

# ImgBB (clave NUEVA) para comprobantes
IMGBB_API_KEY=

# Opcionales
SELF_URL=https://betgroup-proxy-v2-8vqj.onrender.com
UID_PRUEBA=
