# ==================== VARIABLES DE ENTORNO DE BETGROUP PROXY ====================
# Copia estos nombres en Render → tu servicio → Environment.
# NUNCA pongas valores reales en este archivo ni en el código.

# --- Obligatorias (el servidor no arranca sin ellas) ---
FIREBASE_SERVICE_ACCOUNT_B64=
# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
AUDIT_SECRET=

# --- Migración del login antiguo ("Inmune") ---
# El secreto viejo con el que se calcularon los hashes existentes.
# Cuando todos los usuarios hayan entrado al menos una vez, se puede borrar.
LEGACY_PASSWORD_PEPPER=

# --- Opcionales ---
FIREBASE_DATABASE_URL=https://betgroup-cuba-2024-default-rtdb.firebaseio.com
ALLOWED_ORIGINS=https://betgroup-cuba-2024.web.app,https://betgroup-cuba-2024.firebaseapp.com,https://betgroup-proxy-v2-8vqj.onrender.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Varias claves separadas por comas; se reparten por franja horaria.
ODDS_API_KEYS=
# Respaldo de cuotas de fútbol (API-Football, plan gratis de 100 consultas/día). Opcional.
API_FOOTBALL_KEY=
# Clave de ImgBB para subir comprobantes (sin ella la web sube directamente, ya sin metadatos).
IMGBB_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
CF_ACCOUNT_ID=
CF_TOKEN=
TEST_USER_UID=
# Déjalo en false. Solo en true si de verdad quieres poder borrar todo el sistema.
ALLOW_SYSTEM_RESET=false
